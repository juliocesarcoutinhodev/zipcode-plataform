# ============================================
# Stage 1: Build do Angular 21
# ============================================
FROM node:22-alpine AS build

WORKDIR /app

COPY zipsearch/package*.json ./

RUN npm ci

COPY zipsearch/ .

RUN npm run build:prod

# ============================================
# Stage 2: Nginx para servir estaticos
# ============================================
FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist/zip-search-frontend/browser /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:80 || exit 1
